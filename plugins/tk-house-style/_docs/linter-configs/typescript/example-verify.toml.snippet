# Drop into the project's verify.toml for /verify auto-detection.
# /verify (tk-verify) reads this and runs the configured commands.

[verify.typescript]
enabled       = true
package_manager = "pnpm"          # "pnpm" | "npm" | "yarn" | "bun"

# These map to package.json scripts. /verify will invoke
#   <package_manager> run <script>
lint_script      = "lint"          # eslint .
typecheck_script = "typecheck"     # tsc --noEmit
arch_script      = "arch:lint"     # depcruise --config .dependency-cruiser.cjs src

# Optional: fail the run if any of these emit warnings (not just errors).
strict_warnings = ["arch:lint"]

# Optional: file globs /verify should consider "core" for the Tier-2
# grep pass (Step 3a) — try/catch, Date.now, Math.random, etc.
core_globs  = ["src/core/**/*.ts", "src/core/**/*.tsx"]
shell_globs = ["src/shell/**/*.ts", "src/shell/**/*.tsx"]
