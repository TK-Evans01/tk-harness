# Drop into the project's verify.toml for /verify auto-detection.

[verify.python]
enabled = true

# /verify will invoke each command verbatim from the project root.
lint_cmd      = "ruff check ."
format_cmd    = "ruff format --check ."
typecheck_cmd = "mypy --config-file mypy.strict.ini src"
arch_cmd      = "lint-imports --config importlinter.ini"

# Optional: tool runner prefix (e.g. "uv run", "hatch run", "poetry run").
# /verify will prepend this to each command if set.
runner_prefix = ""

# Globs used by the Tier-2 reviewer pass (Step 3a) — try/except,
# time.time, random.*, uuid.*, in core files.
core_globs  = ["src/**/core/**/*.py", "src/core/**/*.py"]
shell_globs = ["src/**/shell/**/*.py", "src/shell/**/*.py"]
