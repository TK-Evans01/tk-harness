# tk-house-style: paste into the workspace `Cargo.toml`.
# Crates inside the workspace inherit these by adding:
#
#   [lints]
#   workspace = true
#
# to their own Cargo.toml.

[workspace.lints.rust]
unsafe_code = "deny"
missing_debug_implementations = "warn"
unreachable_pub = "warn"
rust_2018_idioms = "warn"

[workspace.lints.clippy]
# Broad opt-in groups.
pedantic = { level = "warn", priority = -1 }
nursery  = { level = "warn", priority = -1 }

# Tier-2: ban panicking partial functions in lib code.
unwrap_used = "deny"
expect_used = "deny"
panic       = "deny"
todo        = "warn"
unimplemented = "warn"
dbg_macro   = "deny"

# Docs.
missing_errors_doc = "warn"
missing_panics_doc = "warn"

# CLI vs lib: warn by default, projects shipping libraries should bump
# this to deny.
print_stdout = "warn"
print_stderr = "warn"

# Soft guidance on impure / non-functional patterns.
needless_for_each       = "warn"
unnecessary_wraps        = "warn"
redundant_clone          = "warn"
needless_pass_by_value   = "warn"
cloned_instead_of_copied = "warn"

# Quiet pedantic noise that is too aggressive in practice.
module_name_repetitions = "allow"
must_use_candidate      = "allow"
missing_const_for_fn    = "allow"
